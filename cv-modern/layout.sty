\ProvidesPackage{layout}[2026/05/28 v0.6 Skills hierarchy and visual rhythm]

% --- Layout tokens ---
\newlength{\cvperiodwidth}
\setlength{\cvperiodwidth}{2.95cm}
\newlength{\cvlogocolwidth}
\setlength{\cvlogocolwidth}{1.45cm}
\newlength{\cvlogowidth}
\setlength{\cvlogowidth}{1.15cm}

\newcommand{\cvsectionbefore}{1.15em}
\newcommand{\cvsectionrulegap}{0.4em}
\newcommand{\cvsectionafter}{0.62em}
\newcommand{\cventryvspace}{0.85em}
\newcommand{\cvheaderafter}{0.72em}
\newcommand{\cvskillcategorygap}{0.48em}
\newcommand{\cvskilltitleitems}{0.14em}
\newcommand{\cvskillitemsafter}{0.4em}

% --- Header ---
\newcommand{\cvname}[1]{%
  {\fontsize{20}{24}\selectfont\bfseries #1\par}%
  \vspace{0.4em}%
}

\newcommand{\cvrole}[1]{%
  {\normalsize\color{cvmuted}#1\par}%
  \vspace{0.45em}%
}

\newcommand{\cvhref}[2]{\href{#1}{#2}}

\newcommand{\cvcontactsep}{%
  \hspace{0.5em}{\color{cvrule}\textbar}\hspace{0.5em}%
}

\newcommand{\cvcontact}[1]{%
  {\small\color{cvtext}#1\par}%
  \vspace{0.6em}%
  \noindent\textcolor{cvrule}{\rule{\linewidth}{0.4pt}}%
  \vspace{\cvheaderafter}%
}

% --- Sections: rule — title — rule ---
\newcommand{\cvsectionrule}{%
  \noindent\textcolor{cvrule}{\rule{\linewidth}{0.4pt}}%
}

\newcommand{\cvsection}[1]{%
  \vspace{\cvsectionbefore}%
  \cvsectionrule\par
  \vspace{\cvsectionrulegap}%
  \noindent{\normalsize\bfseries\MakeUppercase{#1}}%
  \par
  \vspace{\cvsectionrulegap}%
  \cvsectionrule\par
  \vspace{\cvsectionafter}%
}

% --- Skills: editorial categories ---
\newcommand{\cvskillcategory}[1]{%
  \vspace{\cvskillcategorygap}%
  \noindent{\normalsize\bfseries\color{cvtext}#1\par}%
  \vspace{\cvskilltitleitems}%
}

\newcommand{\cvskillitems}[1]{%
  \noindent
  {\small\color{cvskills}\linespread{1.12}\selectfont #1\par}%
  \vspace{\cvskillitemsafter}%
}

% --- Experience / education typography ---
\newcommand{\cvperiod}[1]{%
  {\small\bfseries\color{cvtext}#1}%
}

\newcommand{\cvjobtitle}[1]{%
  {\normalsize\bfseries #1\par}%
}

\newcommand{\cvjobcompany}[1]{%
  {\small\color{cvmuted}#1\par}%
}

\newenvironment{cvitems}{%
  \vspace{0.14em}%
  \begin{itemize}[leftmargin=1.15em, itemsep=3pt, topsep=3.5pt, parsep=0pt, partopsep=0pt]%
}{%
  \end{itemize}%
}

% --- Optional logo(s) ---
\newcommand{\cvprintlogo}[1]{%
  \begingroup
  \def\cv@logofile{#1}%
  \def\cv@logorempty{}%
  \ifx\cv@logofile\cv@logorempty
  \else
    \IfFileExists{assets/logos/\cv@logofile}{%
      \raisebox{-0.08em}{\includegraphics[width=\cvlogowidth,keepaspectratio]{assets/logos/\cv@logofile}}%
    }{}%
  \fi
  \endgroup
}

\newlength{\cvlogosmallwidth}
\setlength{\cvlogosmallwidth}{0.85cm}

\newcommand{\cvprintlogosmall}[1]{%
  \IfFileExists{assets/logos/#1}{%
    \raisebox{-0.06em}{\includegraphics[width=\cvlogosmallwidth,keepaspectratio]{assets/logos/#1}}%
  }{}%
}

\newcommand{\cvprintlogos}[2]{%
  \cvprintlogosmall{#1}\hspace{0.1em}\cvprintlogosmall{#2}%
}

\newcommand{\cvlogocell}[1]{%
  \begin{minipage}[t]{\cvlogocolwidth}%
    \raggedleft
    \vspace{0.08em}%
    #1%
  \end{minipage}%
}

% --- Experience entry ---
\newcommand{\cventry}[5]{%
  \vspace{\cventryvspace}%
  \noindent
  \def\cv@entrylogo{#4}%
  \def\cv@logorempty{}%
  \ifx\cv@entrylogo\cv@logorempty
    \begin{tabularx}{\textwidth}{@{}>{\raggedright\arraybackslash}p{\cvperiodwidth}@{}>{\raggedright\arraybackslash}X@{}}
      \cvperiod{#1} &
      \begin{minipage}[t]{\linewidth}
        \cvjobtitle{#2}
        \vspace{0.08em}
        \cvjobcompany{#3}
        #5%
      \end{minipage} \\
    \end{tabularx}%
  \else
    \begin{tabularx}{\textwidth}{@{}>{\raggedright\arraybackslash}p{\cvperiodwidth}@{}>{\raggedright\arraybackslash}X@{}r@{}}
      \cvperiod{#1} &
      \begin{minipage}[t]{\linewidth}
        \cvjobtitle{#2}
        \vspace{0.08em}
        \cvjobcompany{#3}
        #5%
      \end{minipage} &
      \cvlogocell{\cvprintlogo{#4}} \\
    \end{tabularx}%
  \fi
  \par
}

% --- Education (optional second logo in arg 5) ---
\newcommand{\cveducation}[5]{%
  \vspace{\cventryvspace}%
  \noindent
  \def\cv@entrylogoA{#4}%
  \def\cv@entrylogoB{#5}%
  \def\cv@logorempty{}%
  \ifx\cv@entrylogoA\cv@logorempty
    \begin{tabularx}{\textwidth}{@{}>{\raggedright\arraybackslash}p{\cvperiodwidth}@{}>{\raggedright\arraybackslash}X@{}}
      \cvperiod{#1} &
      \begin{minipage}[t]{\linewidth}
        \cvjobtitle{#2}
        \vspace{0.08em}
        \cvjobcompany{#3}
      \end{minipage} \\
    \end{tabularx}%
  \else
    \begingroup
    \setlength{\cvlogocolwidth}{1.95cm}%
    \begin{tabularx}{\textwidth}{@{}>{\raggedright\arraybackslash}p{\cvperiodwidth}@{}>{\raggedright\arraybackslash}X@{}r@{}}
      \cvperiod{#1} &
      \begin{minipage}[t]{\linewidth}
        \cvjobtitle{#2}
        \vspace{0.08em}
        \cvjobcompany{#3}
      \end{minipage} &
      \cvlogocell{%
        \ifx\cv@entrylogoB\cv@logorempty
          \cvprintlogo{#4}%
        \else
          \cvprintlogos{#4}{#5}%
        \fi
      } \\
    \end{tabularx}%
    \endgroup
  \fi
  \par
}
