\ProvidesPackage{layout}[2026/05/29 v1.3 Editorial spacing audit]

% --- Layout tokens ---
\newlength{\cvlogocolwidth}
\setlength{\cvlogocolwidth}{1.4cm}
\newlength{\cvlogowidth}
\setlength{\cvlogowidth}{1.05cm}

% Section header: gap before top rule | inner top/bottom | gap after bottom rule
\newcommand{\cvsectiongapabove}{0.5em}
\newcommand{\cvsectioninnertop}{0.1em}
\newcommand{\cvsectioninnerbottom}{0.08em}
\newcommand{\cvsectiongapbelow}{0.12em}
\newcommand{\cvsectionskillsgapbelow}{0.12em}

\newcommand{\cvsectioncompactgapbelow}{0.08em}

% Experience: pre-entry gap only (no trailing par noise)
\newcommand{\cventryvspace}{0.38em}
\newcommand{\cventrycompactvspace}{0.24em}
\newcommand{\cventrylegacyvspace}{0.18em}

\newcommand{\cvheaderafter}{0.38em}

% Profile photo (source: images/CV_photo; ~27% smaller than initial header layout)
\newlength{\cvphotocolwidth}
\setlength{\cvphotocolwidth}{2.07cm}
\newlength{\cvphotowidth}
\setlength{\cvphotowidth}{1.92cm}

\newcommand{\cvprintphoto}{%
  \includegraphics[width=\cvphotowidth,keepaspectratio]{CV_photo}%
}

\newcommand{\cvskillcategorygap}{0.2em}
\newcommand{\cvskilltitleitems}{0.05em}
\newcommand{\cvskillitemsafter}{0.15em}

% --- Header ---
\newcommand{\cvname}[1]{%
  {\fontsize{19}{22}\selectfont\bfseries #1\par}%
  \vspace{0.26em}%
}

\newcommand{\cvrole}[1]{%
  {\normalsize\color{cvmuted}#1\par}%
  \vspace{0.28em}%
}

\newcommand{\cvhref}[2]{\href{#1}{#2}}

\newcommand{\cvcontactsep}{%
  \hspace{0.45em}{\color{cvrule}\textbar}\hspace{0.45em}%
}

\newcommand{\cvcontact}[1]{%
  {\small\color{cvtext}#1\par}%
  \vspace{0.38em}%
  \noindent\textcolor{cvrule}{\rule{\linewidth}{0.4pt}}%
  \vspace{\cvheaderafter}%
}

% --- Sections: editorial header block (rule + title + rule) ---
\newcommand{\cvsectionrule}{%
  \noindent\textcolor{cvrule}{\rule{\linewidth}{0.4pt}}%
}

% Editorial header unit: \par only where needed; tighten title-to-bottom-rule
\newcommand{\cvsectionblock@draw}[1]{%
  \begingroup
  \setlength{\parskip}{0pt}%
  \setlength{\parindent}{0pt}%
  \cvsectionrule\par
  \vspace{\cvsectioninnertop}%
  \noindent{\normalsize\bfseries\MakeUppercase{#1}}%
  \par
  \vspace{-0.72\baselineskip}%
  \vspace{\cvsectioninnerbottom}%
  \cvsectionrule\par
  \endgroup
}

\newcommand{\cvsectionblock}[2]{%
  \vspace{\cvsectiongapabove}%
  \cvsectionblock@draw{#1}%
  \vspace{#2}%
}

\newcommand{\cvsection}[1]{%
  \cvsectionblock{#1}{\cvsectiongapbelow}%
}

\newcommand{\cvsectionskills}[1]{%
  \cvsectionblock{#1}{\cvsectionskillsgapbelow}%
}

\newcommand{\cvsectioncompact}[1]{%
  \cvsectionblock{#1}{\cvsectioncompactgapbelow}%
}

% --- Skills ---
\newcommand{\cvskillcategory}[1]{%
  \vspace{\cvskillcategorygap}%
  \noindent{\small\bfseries\color{cvtext}#1\par}%
  \vspace{\cvskilltitleitems}%
}

\newcommand{\cvskillitems}[1]{%
  \noindent{\small\color{cvskills}#1\par}%
  \vspace{\cvskillitemsafter}%
}

\newcommand{\cvskillitemscontinue}[1]{%
  \noindent{\small\color{cvskills}#1\par}%
  \vspace{\cvskillitemsafter}%
}

% --- Experience typography ---
\newcommand{\cvjobheadline}[3]{%
  \noindent{\normalsize\bfseries #1}%
  \hspace{0.28em}{\color{cvmuted}\textemdash}\hspace{0.28em}%
  {\normalsize\color{cvmuted}#2}%
  \def\cv@roletype{#3}%
  \def\cv@roletypeempty{}%
  \ifx\cv@roletype\cv@roletypeempty
  \else
    \hspace{0.26em}{\color{cvroletype}\textperiodcentered}\hspace{0.22em}%
    {\footnotesize\color{cvroletype}#3}%
  \fi
  \par\vspace{0.06em}%
}

\newcommand{\cvperiodline}[1]{%
  \noindent{\small\bfseries\color{cvperiod}#1\par}%
}

\newenvironment{cvitems}{%
  \begin{itemize}[leftmargin=1.1em, itemsep=1.25pt, topsep=1.5pt, parsep=0pt, partopsep=0pt, after=\vspace{0pt}]%
}{%
  \end{itemize}%
}

\newenvironment{cvitemscompact}{%
  \begin{itemize}[leftmargin=1.05em, itemsep=0.85pt, topsep=1.25pt, parsep=0pt, partopsep=0pt, after=\vspace{0pt}]%
}{%
  \end{itemize}%
}

\newenvironment{cvitemslegacy}{%
  \begin{itemize}[leftmargin=1em, itemsep=0.5pt, topsep=1pt, parsep=0pt, partopsep=0pt, after=\vspace{0pt}]%
}{%
  \end{itemize}%
}

% --- Logos ---
\newcommand{\cvprintlogo}[1]{%
  \IfFileExists{assets/logos/#1}{%
    \includegraphics[width=\cvlogowidth,keepaspectratio]{assets/logos/#1}}%
  {}%
}

\newlength{\cvlogosmallwidth}
\setlength{\cvlogosmallwidth}{0.72cm}

\newcommand{\cvprintlogosmall}[1]{%
  \IfFileExists{assets/logos/#1}{%
    \includegraphics[width=\cvlogosmallwidth,keepaspectratio]{assets/logos/#1}}%
  {}%
}

\newcommand{\cvprintlogos}[2]{%
  \cvprintlogosmall{#1}\hspace{0.06em}\cvprintlogosmall{#2}%
}

\newcommand{\cvlogocell}[1]{%
  \begin{minipage}[t]{\cvlogocolwidth}%
    \raggedleft
    \vspace{0.06em}%
    #1%
  \end{minipage}%
}

\newcommand{\cvlogocellcompact}[1]{%
  \begin{minipage}[c]{\cvlogocolwidth}%
    \raggedleft
    #1%
  \end{minipage}%
}

% --- Experience ---
\newcommand{\cventry@core}[7]{%
  \vspace{#7}%
  \noindent
  \def\cv@entrylogo{#5}%
  \def\cv@logorempty{}%
  \ifx\cv@entrylogo\cv@logorempty
    \begin{tabularx}{\textwidth}{@{}>{\raggedright\arraybackslash}X@{}}
      \begin{minipage}[t]{\linewidth}
        \cvjobheadline{#2}{#3}{#4}
        \cvperiodline{#1}
        #6%
      \end{minipage} \\
    \end{tabularx}%
  \else
    \begin{tabularx}{\textwidth}{@{}>{\raggedright\arraybackslash}X@{}>{\raggedleft\arraybackslash}m{\cvlogocolwidth}@{}}
      \begin{minipage}[t]{\linewidth}
        \cvjobheadline{#2}{#3}{#4}
        \cvperiodline{#1}
        #6%
      \end{minipage} &
      \cvlogocell{\cvprintlogo{#5}} \\
    \end{tabularx}%
  \fi
}

\newcommand{\cventry}[6]{%
  \cventry@core{#1}{#2}{#3}{#4}{#5}{#6}{\cventryvspace}%
}

\newcommand{\cventrycompact}[6]{%
  \cventry@core{#1}{#2}{#3}{#4}{#5}{#6}{\cventrycompactvspace}%
}

\newcommand{\cventrylegacy}[6]{%
  \cventry@core{#1}{#2}{#3}{#4}{#5}{#6}{\cventrylegacyvspace}%
}

% --- Education (single-line compact) ---
\newcommand{\cveducationinline}[5]{%
  \noindent
  \def\cv@entrylogoA{#4}%
  \def\cv@entrylogoB{#5}%
  \def\cv@logorempty{}%
  \ifx\cv@entrylogoA\cv@logorempty
    \noindent{\small\color{cvtext}\textbf{#1}\hspace{0.28em}{\color{cvmuted}\textemdash}\hspace{0.28em}#2\hspace{0.28em}{\color{cvmuted}\textemdash}\hspace{0.28em}{\color{cvmuted}#3}\par}%
  \else
    \begingroup
    \setlength{\cvlogocolwidth}{1.75cm}%
    \begin{tabularx}{\textwidth}{@{}>{\raggedright\arraybackslash}X@{}>{\raggedleft\arraybackslash}m{\cvlogocolwidth}@{}}
      {\small\color{cvtext}\textbf{#1}\hspace{0.28em}{\color{cvmuted}\textemdash}\hspace{0.28em}#2\hspace{0.28em}{\color{cvmuted}\textemdash}\hspace{0.28em}{\color{cvmuted}#3}} &
      \cvlogocellcompact{%
        \ifx\cv@entrylogoB\cv@logorempty
          \cvprintlogosmall{#4}%
        \else
          \cvprintlogos{#4}{#5}%
        \fi
      } \\
    \end{tabularx}%
    \endgroup
  \fi
}

% --- Languages / Community (inline compact) ---
\newcommand{\cvlanguagesinline}[1]{%
  \noindent{\small\color{cvtext}#1\par}%
}

\newcommand{\cvcommunityinline}[1]{%
  \noindent{\footnotesize\color{cvtext}#1\par}%
}

\newcommand{\cvcommunityitem}[2]{%
  \noindent{\footnotesize\color{cvtext}\textbf{#1}\hspace{0.2em}{\color{cvmuted}\textemdash}\hspace{0.2em}#2\par}%
  \vspace{0.06em}%
}
