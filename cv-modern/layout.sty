\ProvidesPackage{layout}[2026/05/28 v0.8 Two-page senior AI CV layout]

\newlength{\cvlogocolwidth}
\setlength{\cvlogocolwidth}{1.4cm}
\newlength{\cvlogowidth}
\setlength{\cvlogowidth}{1.05cm}

\newcommand{\cventryvspace}{0.5em}
\newcommand{\cventrycompactvspace}{0.34em}
\newcommand{\cventrylegacyvspace}{0.26em}
\newcommand{\cvsectionbefore}{0.68em}
\newcommand{\cvsectionrulegap}{0.2em}
\newcommand{\cvsectionafter}{0.36em}
\newcommand{\cvheaderafter}{0.45em}
\newcommand{\cvskillcategorygap}{0.28em}
\newcommand{\cvskilltitleitems}{0.08em}
\newcommand{\cvskillitemsafter}{0.22em}

\newcommand{\cvname}[1]{{\fontsize{19}{22}\selectfont\bfseries #1\par}\vspace{0.28em}}
\newcommand{\cvrole}[1]{{\normalsize\color{cvmuted}#1\par}\vspace{0.3em}}
\newcommand{\cvhref}[2]{\href{#1}{#2}}
\newcommand{\cvcontactsep}{\hspace{0.45em}{\color{cvrule}\textbar}\hspace{0.45em}}
\newcommand{\cvcontact}[1]{{\small\color{cvtext}#1\par}\vspace{0.4em}\noindent\textcolor{cvrule}{\rule{\linewidth}{0.4pt}}\vspace{\cvheaderafter}}

\newcommand{\cvsectionrule}{\noindent\textcolor{cvrule}{\rule{\linewidth}{0.4pt}}}
\newcommand{\cvsection}[1]{\vspace{\cvsectionbefore}\cvsectionrule\par\vspace{\cvsectionrulegap}\noindent{\normalsize\bfseries\MakeUppercase{#1}}\par\vspace{\cvsectionrulegap}\cvsectionrule\par\vspace{\cvsectionafter}}

\newcommand{\cvskillcategory}[1]{\vspace{\cvskillcategorygap}\noindent{\small\bfseries\color{cvtext}#1\par}\vspace{\cvskilltitleitems}}
\newcommand{\cvskillitems}[1]{\noindent{\small\color{cvskills}#1\par}\vspace{\cvskillitemsafter}}
\newcommand{\cvskillitemscontinue}[1]{\noindent{\small\color{cvskills}#1\par}\vspace{\cvskillitemsafter}}

\newcommand{\cvjobheadline}[2]{\noindent{\normalsize\bfseries #1}\hspace{0.3em}{\color{cvmuted}\textemdash}\hspace{0.3em}{\normalsize\color{cvmuted}#2}\par}
\newcommand{\cvperiodline}[1]{\vspace{0.06em}\noindent{\small\bfseries\color{cvperiod}#1\par}}
\newcommand{\cvjobtitle}[1]{{\normalsize\bfseries #1\par}}
\newcommand{\cvjobcompany}[1]{{\small\color{cvmuted}#1\par}}

\newenvironment{cvitems}{\vspace{0.06em}\begin{itemize}[leftmargin=1.1em,itemsep=1.5pt,topsep=2pt,parsep=0pt,partopsep=0pt]}{\end{itemize}}
\newenvironment{cvitemscompact}{\vspace{0.04em}\begin{itemize}[leftmargin=1.05em,itemsep=1pt,topsep=1.5pt,parsep=0pt,partopsep=0pt]}{\end{itemize}}
\newenvironment{cvitemslegacy}{\vspace{0.03em}\begin{itemize}[leftmargin=1em,itemsep=0.5pt,topsep=1pt,parsep=0pt,partopsep=0pt]}{\end{itemize}}

\newcommand{\cvprintlogo}[1]{\IfFileExists{assets/logos/#1}{\includegraphics[width=\cvlogowidth,keepaspectratio]{assets/logos/#1}}{}}
\newlength{\cvlogosmallwidth}\setlength{\cvlogosmallwidth}{0.8cm}
\newcommand{\cvprintlogosmall}[1]{\IfFileExists{assets/logos/#1}{\includegraphics[width=\cvlogosmallwidth,keepaspectratio]{assets/logos/#1}}{}}
\newcommand{\cvprintlogos}[2]{\cvprintlogosmall{#1}\hspace{0.08em}\cvprintlogosmall{#2}}
\newcommand{\cvlogocell}[1]{\begin{minipage}[t]{\cvlogocolwidth}\raggedleft\vspace{0.12em}#1\end{minipage}}

\newcommand{\cventry@core}[6]{\vspace{#6}\noindent\def\cv@entrylogo{#4}\def\cv@logorempty{}\ifx\cv@entrylogo\cv@logorempty\begin{tabularx}{\textwidth}{@{}>{\raggedright\arraybackslash}X@{}}\begin{minipage}[t]{\linewidth}\cvjobheadline{#2}{#3}\cvperiodline{#1}#5\end{minipage}\\\end{tabularx}\else\begin{tabularx}{\textwidth}{@{}>{\raggedright\arraybackslash}X@{}>{\raggedleft\arraybackslash}m{\cvlogocolwidth}@{}}\begin{minipage}[t]{\linewidth}\cvjobheadline{#2}{#3}\cvperiodline{#1}#5\end{minipage}&\cvlogocell{\cvprintlogo{#4}}\\\end{tabularx}\fi\par}
\newcommand{\cventry}[5]{\cventry@core{#1}{#2}{#3}{#4}{#5}{\cventryvspace}}
\newcommand{\cventrycompact}[5]{\cventry@core{#1}{#2}{#3}{#4}{#5}{\cventrycompactvspace}}
\newcommand{\cventrylegacy}[5]{\cventry@core{#1}{#2}{#3}{#4}{#5}{\cventrylegacyvspace}}

\newcommand{\cveducation}[5]{\vspace{\cventryvspace}\noindent\def\cv@entrylogoA{#4}\def\cv@entrylogoB{#5}\def\cv@logorempty{}\ifx\cv@entrylogoA\cv@logorempty\begin{tabularx}{\textwidth}{@{}>{\raggedright\arraybackslash}X@{}}\begin{minipage}[t]{\linewidth}\cvperiodline{#1}\vspace{0.04em}\cvjobtitle{#2}\cvjobcompany{#3}\end{minipage}\\\end{tabularx}\else\begingroup\setlength{\cvlogocolwidth}{1.85cm}\begin{tabularx}{\textwidth}{@{}>{\raggedright\arraybackslash}X@{}>{\raggedleft\arraybackslash}m{\cvlogocolwidth}@{}}\begin{minipage}[t]{\linewidth}\cvperiodline{#1}\vspace{0.04em}\cvjobtitle{#2}\cvjobcompany{#3}\end{minipage}&\cvlogocell{\ifx\cv@entrylogoB\cv@logorempty\cvprintlogo{#4}\else\cvprintlogos{#4}{#5}\fi}\\\end{tabularx}\endgroup\fi\par}

\newcommand{\cvlanguage}[2]{\noindent{\small\color{cvtext}\textbf{#1}\hspace{0.3em}{\color{cvmuted}\textemdash}\hspace{0.3em}#2\par}\vspace{0.12em}}
\newcommand{\cvlanguagenote}[1]{\noindent{\footnotesize\color{cvmuted}#1\par}}
\newcommand{\cvcommunityitem}[2]{\noindent{\footnotesize\color{cvtext}\textbf{#1}\hspace{0.25em}{\color{cvmuted}\textemdash}\hspace{0.25em}#2\par}\vspace{0.1em}}
