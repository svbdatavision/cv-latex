\ProvidesPackage{layout}[2026/05/28 v0.5 Polish CV layout]

% --- Layout tokens ---
\newlength{\cvperiodwidth}
\setlength{\cvperiodwidth}{2.95cm}
\newlength{\cvlogocolwidth}
\setlength{\cvlogocolwidth}{1.45cm}
\newlength{\cvlogowidth}
\setlength{\cvlogowidth}{1.15cm}

\newcommand{\cvsectionbefore}{1.05em}
\newcommand{\cvsectionrulegap}{0.32em}
\newcommand{\cvsectionafter}{0.5em}
\newcommand{\cventryvspace}{0.72em}
\newcommand{\cvskilllinevspace}{0.32em}
\newcommand{\cvheaderafter}{0.65em}

% --- Header ---
\newcommand{\cvname}[1]{%
  {\fontsize{20}{24}\selectfont\bfseries #1\par}%
  \vspace{0.35em}%
}

\newcommand{\cvrole}[1]{%
  {\normalsize\color{cvmuted}#1\par}%
  \vspace{0.4em}%
}

\newcommand{\cvhref}[2]{\href{#1}{#2}}

\newcommand{\cvcontactsep}{%
  \hspace{0.5em}{\color{cvrule}\textbar}\hspace{0.5em}%
}

\newcommand{\cvcontact}[1]{%
  {\small\color{cvtext}#1\par}%
  \vspace{0.55em}%
  \noindent{\color{cvrule}\rule{\textwidth}{0.4pt}}%
  \vspace{\cvheaderafter}%
}

% --- Sections: rule — title — rule ---
\newcommand{\cvsectionrule}{%
  \noindent{\color{cvrule}\rule{\textwidth}{0.4pt}}%
}

\newcommand{\cvsection}[1]{%
  \vspace{\cvsectionbefore}%
  \cvsectionrule
  \vspace{\cvsectionrulegap}%
  {\normalsize\bfseries\MakeUppercase{#1}\par}%
  \vspace{\cvsectionrulegap}%
  \cvsectionrule
  \vspace{\cvsectionafter}%
}

% --- Skills: inline bullets, natural wraps ---
\newcommand{\cvbullet}[1]{%
  \textbullet\hspace{0.32em}#1\hspace{0.62em}%
}

\newcommand{\cvskillline}[1]{%
  \noindent
  {\small\color{cvtext}#1\par}%
  \vspace{\cvskilllinevspace}%
}

% --- Experience / education typography ---
\newcommand{\cvperiod}[1]{%
  {\small\bfseries\color{cvtext}#1}%
}

\newcommand{\cvjobtitle}[1]{%
  {\normalsize\bfseries #1\par}%
}

\newcommand{\cvjobcompany}[1]{%
  {\small\color{cvmuted}#1\par}%
}

\newenvironment{cvitems}{%
  \vspace{0.12em}%
  \begin{itemize}[leftmargin=1.15em, itemsep=2.5pt, topsep=3pt, parsep=0pt, partopsep=0pt]%
}{%
  \end{itemize}%
}

% --- Optional logo ---
\newcommand{\cvprintlogo}[1]{%
  \begingroup
  \def\cv@logofile{#1}%
  \def\cv@logorempty{}%
  \ifx\cv@logofile\cv@logorempty
  \else
    \IfFileExists{assets/logos/\cv@logofile}{%
      \raisebox{-0.08em}{\includegraphics[width=\cvlogowidth,keepaspectratio]{assets/logos/\cv@logofile}}%
    }{}%
  \fi
  \endgroup
}

% --- Experience entry ---
\newcommand{\cventry}[5]{%
  \vspace{\cventryvspace}%
  \noindent
  \def\cv@entrylogo{#4}%
  \def\cv@logorempty{}%
  \ifx\cv@entrylogo\cv@logorempty
    \begin{tabularx}{\textwidth}{@{}>{\raggedright\arraybackslash}p{\cvperiodwidth}@{}>{\raggedright\arraybackslash}X@{}}
      \cvperiod{#1} &
      \begin{minipage}[t]{\linewidth}
        \cvjobtitle{#2}
        \vspace{0.06em}
        \cvjobcompany{#3}
        #5%
      \end{minipage} \\
    \end{tabularx}%
  \else
    \begin{tabularx}{\textwidth}{@{}>{\raggedright\arraybackslash}p{\cvperiodwidth}@{}>{\raggedright\arraybackslash}X@{}>{\raggedleft\arraybackslash}p{\cvlogocolwidth}@{}}
      \cvperiod{#1} &
      \begin{minipage}[t]{\linewidth}
        \cvjobtitle{#2}
        \vspace{0.06em}
        \cvjobcompany{#3}
        #5%
      \end{minipage} &
      \raisebox{0.2em}{\cvprintlogo{#4}} \\
    \end{tabularx}%
  \fi
  \par
}

% --- Education ---
\newcommand{\cveducation}[4]{%
  \vspace{\cventryvspace}%
  \noindent
  \def\cv@entrylogo{#4}%
  \def\cv@logorempty{}%
  \ifx\cv@entrylogo\cv@logorempty
    \begin{tabularx}{\textwidth}{@{}>{\raggedright\arraybackslash}p{\cvperiodwidth}@{}>{\raggedright\arraybackslash}X@{}}
      \cvperiod{#1} &
      \begin{minipage}[t]{\linewidth}
        \cvjobtitle{#2}
        \vspace{0.06em}
        \cvjobcompany{#3}
      \end{minipage} \\
    \end{tabularx}%
  \else
    \begin{tabularx}{\textwidth}{@{}>{\raggedright\arraybackslash}p{\cvperiodwidth}@{}>{\raggedright\arraybackslash}X@{}>{\raggedleft\arraybackslash}p{\cvlogocolwidth}@{}}
      \cvperiod{#1} &
      \begin{minipage}[t]{\linewidth}
        \cvjobtitle{#2}
        \vspace{0.06em}
        \cvjobcompany{#3}
      \end{minipage} &
      \raisebox{0.2em}{\cvprintlogo{#4}} \\
    \end{tabularx}%
  \fi
  \par
}
