\ProvidesPackage{layout}[2026/05/28 v0.4 Refined CV layout]

% --- Layout tokens ---
\newlength{\cvperiodwidth}
\setlength{\cvperiodwidth}{2.85cm}
\newlength{\cvlogocolwidth}
\setlength{\cvlogocolwidth}{1.5cm}
\newlength{\cvlogowidth}
\setlength{\cvlogowidth}{1.25cm}

\newcommand{\cvsectionvspace}{0.9em}
\newcommand{\cvsectionrulevspace}{0.28em}
\newcommand{\cvsectionaftervspace}{0.45em}
\newcommand{\cventryvspace}{0.55em}
\newcommand{\cvskilllinevspace}{0.28em}

% --- Header ---
\newcommand{\cvname}[1]{%
  {\fontsize{19}{22}\selectfont\bfseries #1\par}%
  \vspace{0.3em}%
}

\newcommand{\cvrole}[1]{%
  {\large\color{cvmuted}#1\par}%
  \vspace{0.35em}%
}

\newcommand{\cvhref}[2]{\href{#1}{#2}}

\newcommand{\cvcontactsep}{%
  \hspace{0.45em}{\color{cvrule}\textbar}\hspace{0.45em}%
}

\newcommand{\cvcontact}[1]{%
  {\small #1\par}%
  \vspace{0.5em}%
  \noindent{\color{cvrule}\rule{\textwidth}{0.5pt}}%
  \vspace{0.55em}%
}

% --- Sections: uppercase + subtle rule ---
\newcommand{\cvsection}[1]{%
  \vspace{\cvsectionvspace}%
  {\bfseries\MakeUppercase{#1}\par}%
  \vspace{\cvsectionrulevspace}%
  \noindent{\color{cvrule}\rule{\textwidth}{0.5pt}}%
  \vspace{\cvsectionaftervspace}%
}

% --- Skills: horizontal bullet chips (no tabularx) ---
\newcommand{\cvbullet}[1]{%
  \textbullet\hspace{0.28em}#1\hspace{0.55em}%
}

\newcommand{\cvskillline}[1]{%
  \noindent
  {\small #1\par}%
  \vspace{\cvskilllinevspace}%
}

% --- Experience / education typography ---
\newcommand{\cvperiod}[1]{%
  {\small\bfseries #1}%
}

\newcommand{\cvjobtitle}[1]{%
  {\normalsize\bfseries #1\par}%
}

\newcommand{\cvjobcompany}[1]{%
  {\small\itshape\color{cvmuted}#1\par}%
}

\newenvironment{cvitems}{%
  \vspace{0.1em}%
  \begin{itemize}[leftmargin=1.1em, itemsep=1.5pt, topsep=2pt, parsep=0pt, partopsep=0pt]%
}{%
  \end{itemize}%
}

% --- Optional logo ---
\newcommand{\cvprintlogo}[1]{%
  \begingroup
  \def\cv@logofile{#1}%
  \def\cv@logorempty{}%
  \ifx\cv@logofile\cv@logorempty
  \else
    \IfFileExists{assets/logos/\cv@logofile}{%
      \raisebox{-0.05em}{\includegraphics[width=\cvlogowidth,keepaspectratio]{assets/logos/\cv@logofile}}%
    }{}%
  \fi
  \endgroup
}

% --- Experience entry ---
\newcommand{\cventry}[5]{%
  \vspace{\cventryvspace}%
  \noindent
  \def\cv@entrylogo{#4}%
  \def\cv@logorempty{}%
  \ifx\cv@entrylogo\cv@logorempty
    \begin{tabularx}{\textwidth}{@{}>{\raggedright\arraybackslash}p{\cvperiodwidth}@{}>{\raggedright\arraybackslash}X@{}}
      \cvperiod{#1} &
      \begin{minipage}[t]{\linewidth}
        \cvjobtitle{#2}
        \vspace{0.04em}
        \cvjobcompany{#3}
        #5%
      \end{minipage} \\
    \end{tabularx}%
  \else
    \begin{tabularx}{\textwidth}{@{}>{\raggedright\arraybackslash}p{\cvperiodwidth}@{}>{\raggedright\arraybackslash}X@{}>{\raggedleft\arraybackslash}p{\cvlogocolwidth}@{}}
      \cvperiod{#1} &
      \begin{minipage}[t]{\linewidth}
        \cvjobtitle{#2}
        \vspace{0.04em}
        \cvjobcompany{#3}
        #5%
      \end{minipage} &
      \raisebox{0.15em}{\cvprintlogo{#4}} \\
    \end{tabularx}%
  \fi
  \par
}

% --- Education ---
\newcommand{\cveducation}[4]{%
  \vspace{\cventryvspace}%
  \noindent
  \def\cv@entrylogo{#4}%
  \def\cv@logorempty{}%
  \ifx\cv@entrylogo\cv@logorempty
    \begin{tabularx}{\textwidth}{@{}>{\raggedright\arraybackslash}p{\cvperiodwidth}@{}>{\raggedright\arraybackslash}X@{}}
      \cvperiod{#1} &
      \cvjobtitle{#2}
      \vspace{0.04em}
      \cvjobcompany{#3} \\
    \end{tabularx}%
  \else
    \begin{tabularx}{\textwidth}{@{}>{\raggedright\arraybackslash}p{\cvperiodwidth}@{}>{\raggedright\arraybackslash}X@{}>{\raggedleft\arraybackslash}p{\cvlogocolwidth}@{}}
      \cvperiod{#1} &
      \cvjobtitle{#2}
      \vspace{0.04em}
      \cvjobcompany{#3} &
      \raisebox{0.15em}{\cvprintlogo{#4}} \\
    \end{tabularx}%
  \fi
  \par
}
